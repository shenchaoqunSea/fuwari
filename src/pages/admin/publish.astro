---
import PublishForm from "@components/admin/PublishForm.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const title = "发布文章 - 超群的代码实验室";
---

<MainGridLayout title={title}>
    <div class="max-w-2xl mx-auto px-4 py-8">
        <div class="mb-8 text-center">
            <h1 class="text-3xl font-bold mb-2">发布文章</h1>
            <p class="text-neutral-500 dark:text-neutral-400">随时随地，记录你的想法</p>
        </div>

        <PublishForm client:load></PublishForm>

        <div class="mt-8 text-center text-sm text-neutral-400 dark:text-neutral-500">
            <p> 提示：普通文章保存在 posts/，朋友圈文章保存在 posts/wechat_moments/</p>
        </div>
    </div>
</MainGridLayout>

<style>
    h1 {
        @apply text-3xl font-bold mb-2;
    }
</style>
